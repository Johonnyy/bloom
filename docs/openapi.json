    "/admin/runs/{run_id}/cancel": {
      "post": {
        "description": "Ask an in-flight run to stop.\n\n202, not 200: cancellation is cooperative and asynchronous. This returns as soon\nas the request is delivered; the *outcome* arrives on the trace as\n``run_finished{status: 'cancelled'}``, the same terminal event every other ending\nproduces. A client that waits for the event rather than this response needs no\nspecial case for stopping.\n\nA run that has already finished is a 409 rather than a 404 \u2014 the run exists, it\nsimply cannot be cancelled, and telling those apart is what lets a UI say \"it\nalready finished\" instead of \"no such run\".",
        "operationId": "cancel_admin_runs__run_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Cancel Admin Runs  Run Id  Cancel Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel",
        "tags": [
          "runs"
        ]
      }
    },
