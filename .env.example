# Bloom configuration — copy to `.env` and fill in.
# All values are read by app/config.py (pydantic-settings). Env vars override .env.
#
# One prefix, three consumers. Bloom embeds agent-mcp-py and agent-runtime, both
# of which would happily read their own AGENT_MCP_* / AGENT_RUNTIME_* variables.
# They are configured by injection from the values below instead. Never add a
# second prefix to this file — it would be ignored, which is the worst outcome.

# --- App ---
# Must be snake_case, start with a letter, and be at most 22 characters —
# agent-mcp-py prefixes it onto every tool as <app>__<tool> and validates it at
# server construction, so a bad value fails at startup, not at call time.
BLOOM_APP_NAME=bloom
BLOOM_VERSION=0.2.1
BLOOM_PORT=8010
BLOOM_LOG_LEVEL=info

# Bloom's externally reachable base URL. Used to build the OAuth redirect_uri, so
# it must be the public name a provider can redirect a browser to — not a
# loopback address, and not a name only reachable inside the Docker network.
#   BLOOM_PUBLIC_URL=https://bloom.johnny.dev
BLOOM_PUBLIC_URL=

# --- Storage ---
# One SQLite file with three tenants: Bloom's own tables, agent-mcp-py's tool log
# (agent_mcp_usage) and agent-runtime's cost rows (agent_runtime_usage). They
# share conversation_id / app_name / depth / created_at, which is what lets spend
# be joined to the calls that caused it. In Docker this needs a volume.
BLOOM_DB_PATH=data/bloom.db

# --- The loop (agent-runtime) ---
# Required to run anything. Without it the admin API still works, which is
# deliberate: editing configurations before you have a key is a real workflow.
BLOOM_OPENROUTER_API_KEY=

# A named tier, not a model id — agent_runtime.model_router resolves it, so
# upgrading every agent is one edit there. A literal "vendor/model" also works.
BLOOM_DEFAULT_TIER=balanced
BLOOM_MAX_TOKENS=2048

# Ceilings a config may lower but not raise. A delegated task is unattended by
# definition, so this is the only thing between a bad prompt and an open bill.
BLOOM_MAX_STEPS=8
BLOOM_MAX_COST_USD=0.50
# Wall clock for one run. Without it a hung provider call leaves a run marked
# `running` forever and any client tailing its trace never sees a terminal event.
BLOOM_RUN_TIMEOUT_S=300

# --- Bloom's MCP server: how other agents delegate here ---
# On by default, unlike every other app in the ecosystem. Being reachable over MCP
# is the reason this service exists. It still fails closed without keys below.
BLOOM_FEATURE_MCP=true

# Bearer keys for inbound MCP calls, comma-separated. Either bare tokens or
# "caller_name:token" pairs, which is better because the usage log then
# attributes each call to a name instead of a hash.
#   BLOOM_MCP_KEYS=amber:s3cret
# agent-mcp-py fails closed: with FEATURE_MCP=true and no keys here the server
# refuses to build. app/config.py's mcp_enabled property guards that, so an
# unconfigured install quietly serves the admin API only instead of crashing.
BLOOM_MCP_KEYS=

# Required for sync-store registration. Empty means registration is skipped and
# Bloom still serves normally — but nothing will discover it.
BLOOM_MCP_PUBLIC_URL=

# The hosted registry (amber-infra/sync-store). With these set, Bloom registers
# itself on startup and discovers peers on a heartbeat.
BLOOM_MCP_SYNC_STORE_URL=
BLOOM_MCP_SYNC_STORE_TOKEN=

# Peer MCP servers a configured agent may call, as "name=https://host" pairs.
# Static entries always win over anything discovered from the sync store, so a
# local override during an incident sticks.
#   BLOOM_MCP_PEERS=amber=https://amber.johnny.dev,finance=https://finance.johnny.dev
BLOOM_MCP_PEERS=
BLOOM_MCP_PEER_TOKEN=

# --- The management surface (Aperture) ---
# Deliberately NOT the same keys as BLOOM_MCP_KEYS. Aperture edits configuration;
# a peer agent spends money. One leaked token should not buy both.
#   BLOOM_ADMIN_KEYS=aperture:s3cret
BLOOM_ADMIN_KEYS=

# --- Model keywords ---
# Which model an agent runs on is named by keyword — `balanced`, `coding`,
# `research` — not by a model id. Bloom ships the ecosystem's ten keywords and
# overlays whatever the shared sync store above says they currently point at, so
# re-pointing `coding` once moves Amber and Bloom together instead of needing a
# release per app. With no sync store configured, the built-ins are the whole
# truth and nothing here ever makes a request. Read them at
# GET /admin/models/keywords.
BLOOM_MODEL_SYNC_INTERVAL_S=300

# --- The builder: the agent that writes other agents ---
# "Create a spotify agent" — researches the service, prefers an MCP server over
# anything it would have to build, creates the agent and its connections, and
# hands back the setup steps a human still has to do. Reached from Aperture at
# POST /admin/builder/build, and from Amber as the `build_agent` MCP tool.
BLOOM_FEATURE_BUILDER=true

# The builder's own model. It reasons about an unfamiliar API from search results
# and writes another agent's instructions, which is the kind of open-ended work
# the cheap rungs are bad at.
BLOOM_BUILDER_KEYWORD=strong

# The builder's own ceilings, separate from the service-wide ones above. A real
# build is 12-25 steps — inspect, search the registry, read a page or two,
# create, verify, write the checklist — against a service default of 8. Raising
# BLOOM_MAX_STEPS instead would raise it for every unattended delegated task,
# which is exactly what that ceiling exists to prevent.
#
# BE AWARE OF THE COST. At `strong`, a build genuinely reaches $0.50-$2.00 —
# roughly 4-40x a normal run. That is the deal: you pay once to author something
# you then run cheaply, and this ceiling is what bounds a bad one.
BLOOM_BUILDER_MAX_STEPS=30
BLOOM_BUILDER_MAX_COST_USD=2.00
BLOOM_BUILDER_RUN_TIMEOUT_S=900

# --- Research (the builder's eyes) ---
# A Tavily API key, from https://tavily.com. REQUIRED for the builder: without it
# POST /admin/builder/build answers 503 rather than letting the model write an
# integration from memory. Nothing else in Bloom uses it.
BLOOM_SEARCH_API_KEY=
BLOOM_SEARCH_MAX_RESULTS=5
BLOOM_SEARCH_TIMEOUT_S=15

# `read_url` fetches pages nobody vetted, so both limits bound a hostile answer:
# bytes taken off the wire, and characters handed to the model. It also refuses
# any host resolving to a loopback, private or link-local address, *before* an
# HTTP client is constructed — Bloom sits beside other services on this box.
BLOOM_READ_URL_MAX_BYTES=400000
BLOOM_READ_URL_MAX_CHARS=20000
BLOOM_READ_URL_TIMEOUT_S=20

# The official MCP Registry. Searched before anything else, because an existing
# MCP server always beats an integration Bloom would have to carry itself.
BLOOM_MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io

# --- OAuth (connected accounts) ---
BLOOM_FEATURE_OAUTH=false

# Fernet keys, comma-separated, NEWEST FIRST: the head encrypts, all of them
# decrypt. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Storing an OAuth token without a key is not a degraded mode, it is a breach, so
# the OAuth routes report 503 rather than fall back to plaintext.
BLOOM_FERNET_KEYS=

# Proactive refresh: how often to sweep, and how far ahead of expiry to refresh.
# The skew is generous on purpose — refreshing early costs one HTTP call,
# refreshing late costs a task failing mid-run.
BLOOM_OAUTH_REFRESH_INTERVAL_S=300
BLOOM_OAUTH_REFRESH_SKEW_S=600

# Per-provider client credentials are read by the names each provider manifest
# declares (app/providers/*.toml), not through this prefix — the set of providers
# is not known when app/config.py is defined, and adding one must not mean
# editing Python.
#
# These are a *deployment default*: a connection may carry its own client id and
# secret, entered in Aperture, and those win. Setting them here is the way to
# share one registered app across every connection to that provider.
#
# They work from this file because app/config.py calls load_dotenv() — see the
# comment there. Uncomment and fill to use them.
#   BLOOM_OAUTH_SPOTIFY_CLIENT_ID=
#   BLOOM_OAUTH_SPOTIFY_CLIENT_SECRET=
